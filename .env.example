# Copy this file to .env.local and fill in your actual Supabase project values.
# Find both under Project Settings > API in the Supabase dashboard.
# The anon key is safe to expose in frontend code — it's the public, RLS-protected key,
# not a secret. Never put the service_role key in frontend code.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
